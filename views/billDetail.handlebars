
<style>
  .title { font-size: 32px; } .text-label { font-size: 20px; line-height: 24px;
  } .text-label span { color: #ffe11b; } .text-status { color: white;}
  .text-label-order{ font-size: 20px; line-height: 24px; } .text-label-lg{
  font-size: 16px; line-height: 18px; } .text-total-amount{ font-size: 28px; }
</style>

<!-- Container -->
<div class="max-w-[1100px] mx-auto px-4 py-8 text-white">
  <!-- Bill Detail Card -->
  <div class="shadow-lg">
    <h2 class="title">Thông Tin Chi Tiết Đơn Hàng</h2>
    <div class="mt-6 flex flex-col gap-4">
      <h3 class="text-label font-normal">Khách Hàng:
        <span class="font-semibold">{{orderDetail.customerName}}</span></h3>
      <p class="mt-1 text-label">Mã Đơn Hàng:
        <span class="">{{orderDetail.orderNumber}}</span></p>
        
      <!-- Status -->
      <p class="mt-3 text-label-order">Hình Thức Thanh Toán:
        {{#if (eq orderDetail.paymentMethod "cash")}}
          <span class="">Tiền mặt</span>
        {{else}}
          <span class="">Chuyển khoản ngân hàng</span>
        {{/if}}
      </p>
      <p class="mt-1 text-label">Ngày Đặt:
        <span class="">{{format_date orderDetail.orderDate}}</span></p>

      <!-- Status -->
      <p class="mt-3 text-label-order">Trạng Thái Đơn Hàng:

        {{#if (eq orderDetail.status "Đang xử lý")}}
          <span class="py-1 rounded-full bg-gray-500 px-4 text-white">Đang xử lý</span>
        {{else if (eq orderDetail.status 'Đang giao hàng')}}
          <span class="px-2 py-1 rounded-full bg-green-500 px-4 text-white">Đang giao hàng</span>
        {{else if (eq orderDetail.status 'Đã hoàn tất')}}
          <span class="px-2 py-1 rounded-full bg-blue-500 px-4 text-white">Đã hoàn tất</span>
        {{else}}
          <span class="px-2 py-1 rounded-full bg-red-500 px-4 text-white">Bị hủy</span>
        {{/if}}
      
      {{#unless (eq orderDetail.paymentMethod "cash")}}
        <p class="mt-3 text-label-order">Trạng Thái Thanh Toán:
          {{#if (eq orderDetail.paymentStatus "DONE")}}
            <span class="py-1 rounded-full bg-green-500 px-4 text-white">Đã thanh toán</span>
          {{else}}
            <span class="px-2 py-1 rounded-full bg-gray-500 px-4 text-white">Chưa thanh toán</span>
          {{/if}}
        </p>
      {{/unless}}
    </div>

    <!-- Bill Details Table -->
    <div class="mt-6">
      <table class="min-w-full table-auto text-left">
        <thead>
          <tr class="bg-gray-700 border-b">
            <th class="w-[40%] px-4 py-3 text-label font-medium">Tên Sản Phẩm</th>
            <th class="px-4 py-3 text-label font-medium">Số Lượng</th>
            <th class="px-4 py-3 text-label font-medium">Giá</th>
            <th class="px-4 py-3 text-label font-medium">Tổng Cộng</th>
          </tr>
        </thead>
        <tbody>
          {{#each this.orderList}}
            <!-- Example Row 1 -->
            <tr class="border-b">
              <td
                class="px-4 py-3 text-label-lg flex justify-start items-center gap-8"
              >
                <img
                  class="w-40 h-40"
                  src="/img/{{productID}}/{{main}}"
                  alt=""
                />
                {{productName}}
              </td>
              <td class="px-4 py-3 text-label-lg">{{quantity}}</td>
              <td
                class="px-4 py-3 text-label-lg text-blue-400 font-bold"
              >{{format_number priceEach}}
                đ</td>
              <td
                class="px-4 py-3 text-label-lg text-blue-400 font-bold"
              >{{format_number total}}
                đ</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <!-- Total Section -->
    <div class="mt-8 flex justify-between items-center">
      <div class="text-xl font-semibold text-label-order">
        <p>Tổng Cộng:
          <span class="text-total-amount font-bold text-red-500">{{format_number
              totalAmount
            }}
            đ</span></p>
      </div>
    </div>
  </div>
</div>